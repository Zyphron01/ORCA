# SAMUDRA-AI / ORCA .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment secrets
.env
*.env.local

# Node.js
node_modules/
.next/
dist/
build/
*.local

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Docker volumes
pgdata/
redis_data/

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo
.DS_Store

# Models / large files (Phase 5+)
models/*.tflite
models/*.bin
models/vosk-*/
models/whisper-*/

# Alembic
# Keep migrations in git
# alembic/versions/*.py  <-- DO NOT gitignore these

# Temporary
tmp/
scratch/
*.tmp

# PPT/PDF source docs (keep in docs/ folder, not root)
*.pptx
*.pptx_extracted/
docs_*.txt
docs_*.pdf
main_ppt.txt
mobile_tech.txt

# Debug/Local artifacts
global_traceback.txt
results.txt
test_script.py
