# ============================================================
# orca-AI / ORCA — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- LLM Configuration -------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=your-llm-api-key-here
ORCA_MAX_ITERATIONS=10
ORCA_TEMPERATURE=0.2

# ---- Database --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://orca:orca@localhost:5432/orca
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca
POSTGRES_DB=orca

# ---- Redis / Celery -------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- App -------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Feature Flags ---------------------------------------------
# When true, all external data adapters return realistic mock data.
# Set false + provide real credentials to use live government APIs.
ENABLE_DEMO_MODE=true

# Real government data source flags (Phase 3+)
ENABLE_REAL_INCOIS=false
ENABLE_REAL_IMD=false
ENABLE_REAL_BHOONIDHI=false
ENABLE_REAL_TRANSPONDER=false

# ---- External APIs (real, Phase 3+) ---------------------------
# INCOIS THREDDS
INCOIS_THREDDS_BASE=https://incois.gov.in/thredds

# IMD Mausam
IMD_MAUSAM_BASE=https://api.mausam.imd.gov.in

# Bhoonidhi STAC
BHOONIDHI_STAC_BASE=https://bhoonidhi.nrsc.gov.in/bhoonidhi/stac

# ---- STT / TTS (Phase 5+) -------------------------------------
VOSK_MODEL_PATH=./models/vosk-model-small-en-in-0.4
WHISPER_MODEL=tiny
TTS_ENGINE=pyttsx3

# ---- Offline H3 Cache (Phase 14+) ----------------------------
H3_CACHE_RESOLUTION=8
H3_CACHE_MAX_MB=3
